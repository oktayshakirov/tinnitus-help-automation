              "outputPropertyName": "chunk"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 3000,
      "id": "eb8c5a99-9801-43c8-ae50-9d89458ce39a"
    },
