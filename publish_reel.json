          "jsCode": "// Instagram encodes the video before the container can be published. Polling\n// forever would hang the run, so cap it: 20 attempts at 15s is five minutes,\n// well past the normal encode time for a short.\nconst attempt = ($runIndex ?? 0) + 1;\nif (attempt >= 20) {\n  const status = $('IG Container Status').item.json.status_code;\n  throw new Error(`Instagram container still ${status} after ${attempt} checks. Nothing was published; check the Meta status page and retry.`);\n}\nreturn $input.all();"
        },
