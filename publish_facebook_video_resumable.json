    {
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        100
      ],
      "parameters": {
        "jsCode": "// The cover nodes are continueRegularOutput: the video is already published\n// when they run, and a red execution would invite a re-run, which re-uploads\n// the whole video to the Page.\nlet facebookCoverSet = false;\ntry {\n  const c = $('FB Set Video Cover').first().json;\n  facebookCoverSet = c?.success === true || c?.id != null;\n} catch (e) {}\nreturn [{ json: {\n  facebookVideoId: $('FB Start').first(0, 0).json.video_id,\n  finished: $('FB Finish').first().json.success === true,\n  title: $('Normalise Input').first(0, 0).json.title,\n  fileSize: $('Normalise Input').first(0, 0).json.fileSize ?? null,\n  facebookCoverSet,\n} }];"
      },
      "id": "29c47c85-787b-480c-b559-607bd76f3336"
    }
