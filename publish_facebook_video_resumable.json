            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "facebookGraphApi": {
          "id": "ltfxXBWtUWu9wRg3",
          "name": "Facebook Graph (TinnitusHelp)"
        }
      },
      "retryOnFail": true,
