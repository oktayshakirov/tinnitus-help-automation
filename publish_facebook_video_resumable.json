      "webhookId": "fb-video-resumable-tinnitus",
      "parameters": {
        "formTitle": "Tinnitus Help: Publish Facebook Video (Resumable)",
        "formDescription": "Native long-form Page video, pushed in chunks from the local publish server (tools/range_server.py on 127.0.0.1:8765). Use this for long renders; Facebook drops the file_url fetch of big files.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "videoUrl",
              "requiredField": true
            },
            {
              "fieldLabel": "title",
              "requiredField": true
            },
            {
              "fieldLabel": "description",
              "fieldType": "textarea",
              "requiredField": false
            },
            {
              "fieldLabel": "thumbUrl",
              "requiredField": false
            }
          ]
        },
        "options": {},
        "path": "fb-video-resumable-tinnitus"
      },
      "id": "eea73668-ae27-46c4-9105-9a5930569c92"
    },
    {
      "name": "Normalise Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "jsCode": "const j = $json;\nconst pick = (label, idx) => String(j[label] ?? j[`field-${idx}`] ?? '').trim();\n\nconst videoUrl = pick('videoUrl', 0);\nconst title = pick('title', 1);\nconst rawDescription = pick('description', 2);\nconst thumbUrl = pick('thumbUrl', 3);\n\n// **This workflow pushes the file to Facebook; Facebook never pulls it.** The\n// file_url version (Publish Facebook Video) hands Facebook a tunnel URL and\n// waits on one synchronous POST, and on 2026-11-20 Facebook dropped that\n// fetch of a 508 MB session at its 120s gateway timeout - twice, nothing\n// landed. Here n8n reads the render off the local server in the byte ranges\n// Facebook asks for and uploads each one (upload_phase start/transfer/finish).\n// So the file only has to be reachable from this machine: a\n// http://127.0.0.1:8765/... URL, or a tunnel URL, which is mapped back to it.\n// The server must honour Range - tools/range_server.py in\n// video-edit-automation; the stdlib http.server ignores it.\nconst LOCAL_ORIGIN = 'http://127.0.0.1:8765';\nconst localise = (u) => {\n  try {\n    const p = new URL(u);\n    if (/\\.trycloudflare\\.com$/.test(p.hostname)) return LOCAL_ORIGIN + p.pathname;\n    return u;\n  } catch (e) {\n    return u;\n  }\n};\nconst videoFetchUrl = localise(videoUrl);\nif (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):8765\\//.test(videoFetchUrl)) {\n  throw new Error(`videoUrl must be on the local publish server (127.0.0.1:8765) or its tunnel, got: ${videoUrl || '(empty)'}`);\n}\nif (!title) throw new Error('title is empty.');\n\n// Same trim as Publish Facebook Video: the first paragraph plus the link line,\n// because the caller passes the full YouTube description.\nfunction trimForFacebook(text) {\n  if (!text) return '';\n  const paragraphs = text.split(/\\n\\s*\\n/).map((p) => p.trim()).filter(Boolean);\n  const first = paragraphs[0] ?? '';\n  const lines = text.split('\\n').map((l) => l.trim());\n  const linkLine =\n    lines.find((l) => /^Full article:\\s*https?:\\/\\/\\S+/.test(l)) ??\n    lines.find((l) => /https?:\\/\\/\\S+/.test(l));\n  if (!linkLine || first.includes(linkLine)) return first;\n  return `${first}\\n\\n${linkLine}`;\n}\nconst description = trimForFacebook(rawDescription);\n\n// The cover is fetched as bytes and POSTed to /{id}/thumbnails - Facebook has\n// no URL-based cover parameter (see docs/publish/instagram-facebook.md).\nconst coverFetchUrl = thumbUrl ? localise(thumbUrl) : '';\n\nreturn [{ json: { videoFetchUrl, title, description, coverFetchUrl } }];"
      },
      "id": "13cc03cd-cc2c-4bd5-af59-a00a9a6b8706"
    },
